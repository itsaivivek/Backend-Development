<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>
    <div class="min-h-screen bg-zinc-800 text-white px-6 py-2 flex flex-col gap-4">
        <div class="flex flex-col gap-2">
            <h2 class="text-3xl">Create New User</h2>
            <form class="w-full flex flex-col gap-2" action="/create" method="post">
                <label for="username">Username:</label>
                <input class="outline-none border py-2 px-5 rounded-md border-zinc-600" type="text" name="username"
                id="username" placeholder="john123">
                <label for="email">Email:</label>
                <input class="outline-none border py-2 px-5 rounded-md border-zinc-600" type="email" name="email"
                id="email" placeholder="john123@gmail.com">
                <label for="imageUrl">Image URL:</label>
                <input class="outline-none border py-2 px-5 rounded-md border-zinc-600" type="text" name="imageUrl"
                    id="imageUrl" placeholder="https://www.john.com/profilepicture">
                <input class="bg-sky-600 px-5 py-2 rounded-md" type="submit" value="Create User">
            </form>
        </div>
        <div class="flex flex-col gap-4">
            <h2 class="text-3xl">All Users</h2>

            <div class="users flex flex-wrap gap-4">
                <% if(users.length> 0) {%>
                    <% users.forEach(user => { %>
                        <div class="user bg-zinc-700 w-fit p-3 rounded-xl flex flex-col gap-3 shadow-xs">
                            <div class="w-40 h-40 rounded-xl overflow-hidden">
                                <img class="w-full h-full object-cover"
                                    src=<%= user.imageUrl %> alt="">
                            </div>
                            <div class="flex flex-col gap-1">
                                <h3 class="text-2xl"><%= user.username %></h3>
                                <h4 class="text-md text-sky-500"><%= user.email %></h4>
                            </div>
                            <div class="flex justify-between items-center mt-2">
                                <a href="/edit/<%= user._id %>" class="text-xs text-yellow-400 cursor-pointer">Edit</a>
                                <a href="/delete/<%= user._id %>" class="text-xs text-red-400 cursor-pointer">Delete</a>
                            </div>
                        </div>
                    <% }); %>

                    <% } else{ %>
                        <h4 class="text-zinc-500 mx-auto">No users yet.</h4>
                        <% } %>
            </div>

        </div>
    </div>
</body>

</html>