<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to UserBase</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 font-sans antialiased text-gray-900 min-h-screen">

    <!-- Navigation Bar -->
    <nav class="bg-white border-b border-gray-100 sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4">
            <div class="flex justify-between h-16 items-center">
                <!-- Logo -->
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold">T</div>
                    <span class="text-xl font-bold tracking-tight text-gray-900">Tweeter</span>
                </div>
                <!-- Auth Menus -->
                <div class="flex items-center gap-4">
                    <a href="/login" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition">Login</a>
                    <a href="/register" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-xl transition text-sm shadow-sm">
                        Register
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Layout -->
    <main class="max-w-3xl mx-auto px-4 py-12 space-y-12">
        
        <!-- App Explanation / Hero Section -->
        <div class="text-center max-w-2xl mx-auto space-y-4">
            <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
                Share ideas, track feeds.
            </h1>
            <p class="text-lg text-gray-500 leading-relaxed">
                UserBase is a stripped-down platform built for simple text sharing. Register an account to broadcast your thoughts instantly and view real-time feed updates from other professionals globally.
            </p>
            <div class="pt-2">
                <a href="/home" class="inline-block bg-white hover:bg-gray-50 text-gray-700 font-medium py-2.5 px-6 rounded-xl border border-gray-300 transition text-sm focus:outline-none focus:ring-2 focus:ring-gray-200">
                    Explore Directory
                </a>
            </div>
        </div>

        <!-- Recent Activity Feed -->
        <div class="space-y-4">
            <!-- Section Header -->
            <div class="border-b border-gray-200 pb-2">
                <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider">What's New on the Platform</h2>
            </div>

            <!-- Sample Post 1 -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 bg-indigo-100 text-indigo-700 font-bold rounded-full flex items-center justify-center flex-shrink-0 text-sm">
                        SJ
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-bold text-gray-900 truncate">Sarah Jenkins</span>
                            <span class="text-xs text-gray-400">&middot; Just now</span>
                        </div>
                        <p class="text-sm text-gray-700 mt-2 leading-relaxed">
                            Building static structural prototypes with component classes is incredibly rapid. Tailwind keeps your design system entirely unified out of the box.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Sample Post 2 -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 bg-indigo-100 text-indigo-700 font-bold rounded-full flex items-center justify-center flex-shrink-0 text-sm">
                        MC
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-bold text-gray-900 truncate">Marcus Chen</span>
                            <span class="text-xs text-gray-400">&middot; 1h ago</span>
                        </div>
                        <p class="text-sm text-gray-700 mt-2 leading-relaxed">
                            Decoupling data layers from frontend presentational views. Keeping layouts simple makes structural code management a breeze long-term.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </main>

</body>
</html>
