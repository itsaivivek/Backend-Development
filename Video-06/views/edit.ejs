<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.css" rel="stylesheet" />


</head>

<body class="bg-zinc-800 text-white px-10 pt-5">
    <a href="/" class="text-sky-500 active:scale-95 hover:text-sky-400 ">Go to Home</a>
    <div class="mt-5 flex-col gap-4">
        <form action="/edit" method="post" class="max-w-sm my-10">
            <div class="mb-5">
                <label for="title" class="block mb-2.5 text-sm font-medium text-heading">Previous Name</label>
                <input type="text" id="previousName" name="previousName"
                    class="text-black placeholder:text-zinc-600 bg-zinc-500 border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body"
                    placeholder="Go to the store..." required readonly value="<%= taskname %>"/>
            </div>
            <div class="mb-5">
                <label for="title" class="block mb-2.5 text-sm font-medium text-heading">New Name</label>
                <input type="text" id="newName" name="newName"
                    class="text-black placeholder:text-zinc-600 border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body"
                    placeholder="example.txt" required />
            </div>
            <button type="submit"
                class="text-white bg-yellow-600 box-border border border-transparent hover:bg-sky-400 shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none active:scale-95">Submit</button>
        </form>
    </div>




    <script src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"></script>

</body>

</html>